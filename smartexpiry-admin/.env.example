# ─────────────────────────────────────────────────────────────
# SmartExpiry Admin — environment variables (template)
# Copy to `.env` and fill in the values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL (no Docker). Shared with the Employee app.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_expiry?schema=public"

# ── App ──────────────────────────────────────────────────────
# Public URL of this app. Used for absolute URLs (e.g. in emails).
APP_URL="http://localhost:3000"
# Public URL of the Employee app (the landing page's "Login as Employee" buttons).
# Read at build time: set it before `npm run build`.
EMPLOYEE_APP_URL="http://localhost:3001"

# ── Auth tokens ──────────────────────────────────────────────
# Generate each secret with:  openssl rand -base64 48
# Use DIFFERENT values for access and refresh secrets.
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_TTL_MINUTES=15       # short-lived JWT sent on every request
REFRESH_TOKEN_TTL_DAYS=7          # long-lived token used to renew the access token
EMAIL_OTP_TTL_MINUTES=10          # how long the email verification code (OTP) stays valid

# Encrypts employee passwords so the admin can view them in the Employees table.
# Generate with:  openssl rand -base64 32   (keep it safe — losing or changing it
# makes stored employee passwords unreadable; logins still work).
EMPLOYEE_PASSWORD_KEY=""

# ── Email (SMTP) ─────────────────────────────────────────────
# Required — verification codes (OTP) are sent by email. Without these
# settings registration still works but the code email cannot be sent.
#
# Gmail example:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER="you@gmail.com"   SMTP_PASS="<16-char App Password>"
#   (Google Account → Security → 2-Step Verification → App passwords)
#
# Mailtrap / Ethereal (safe testing inboxes) also work: use their SMTP credentials.
# SMTP_SECURE=true for port 465, false for 587 (STARTTLS).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SmartExpiry <no-reply@smartexpiry.local>"

# Calendar used for "today" in expiry counts (IANA zone name)
APP_TIMEZONE=Asia/Kolkata

# ── AI assistant (Google Gemini) ─────────────────────────────
# Free key from https://aistudio.google.com/apikey. Empty = quick answers only (no AI).
GEMINI_API_KEY=""
# Models tried in order. When one hits its free limit (or is retired), the next answers.
# Check current free models at https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODELS="gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash"
# AI answers per admin per day (protects the shared free quota). 0 = no app limit.
AI_DAILY_LIMIT=50
