# ─────────────────────────────────────────────────────────────
# SmartExpiry Employee — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Same PostgreSQL database as the Admin app (the Admin app owns the migrations).
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/smart_expiry?schema=public

# Public URL of this app
APP_URL=http://localhost:3001
# Public URL of the SmartExpiry website / Admin app (landing page + admin login links).
# Read at build time: set it before `npm run build`.
SITE_URL=http://localhost:3000

# Auth token secrets: at least 32 characters each, and DIFFERENT from the Admin app's.
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Access token lifetime (minutes) and refresh token / session lifetime (days)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Calendar used for "today" in expiry counts (IANA zone name)
APP_TIMEZONE=Asia/Kolkata
